# Telegram (same variable names as legacy GOOL Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_EXTRA_CHAT_IDS=
TELEGRAM_SUBSCRIBERS_FILE=/data/telegram_subscribers.json

# GOOL Multi Telegram cutover.
# active = production: suppress legacy strategy delivery and send one Multi BEST BET/result image.
# shadow = rollback/diagnostics: keep legacy strategy cards, Multi records decisions only.
GOOL_MULTI_TELEGRAM_MODE=active

# Persistent runtime storage
RUNTIME_DATA_DIR=/data
GOOL_INBOX_DIR=/data/raw/live
SIGNAL_JOURNAL_PATH=/data/live/signal_journal.json
SIGNAL_ANALYSIS_PATH=/data/live/gool_bot2_analysis.jsonl
GOOL_MULTI_ANALYSIS_PATH=/data/live/gool_multi_analysis.jsonl
GOOL_MULTI_JOURNAL_PATH=/data/live/gool_multi_journal.json

# GOOL Multi virtual bankroll
GOOL_MULTI_BANK_STATE_PATH=/data/live/gool_multi_bank_state.json
GOOL_MULTI_BANK_INITIAL_RUB=100000
GOOL_MULTI_BANK_STAKE_PCT=0.02
GOOL_MULTI_BANK_REPORT_HOUR=23
GOOL_MULTI_BANK_REPORT_MINUTE=59
REPORT_TIMEZONE=Europe/Moscow

# Live runtime
LIVE_INTERVAL_SECONDS=60
LIVE_COOLDOWN_MINUTES=12
CORE_ANALYSIS_PREFILTER=38
SECONDARY_PROVIDER_INTERVAL_MINUTES=3
MODEL_MAX_DISAGREEMENT=0.20

# Hockey + basketball in the same GOOL bot.
# shadow = collect/settle/journal without automatic sport signal pushes.
# active = send confirmed sport cards to the same Telegram subscribers.
GOOL_MULTISPORT_ENABLED=1
GOOL_MULTISPORT_MODE=shadow
GOOL_MULTISPORT_INTERVAL_SECONDS=20
GOOL_HOCKEY_ENABLED=1
GOOL_BASKETBALL_ENABLED=1
GOOL_MULTISPORT_MIN_ODD=1.45
GOOL_MULTISPORT_MAX_ODD=3.25
GOOL_MULTISPORT_MIN_FAIR_EDGE_PP=3.0
# Resilient 1xBet index/sub-game caches and scoped market brains.
GOOL_MULTISPORT_INDEX_CACHE_SECONDS=180
GOOL_MULTISPORT_PREMATCH_INDEX_CACHE_SECONDS=600
GOOL_MULTISPORT_LIVE_SUBGAME_CACHE_SECONDS=28
GOOL_MULTISPORT_PREMATCH_SUBGAME_CACHE_SECONDS=180
GOOL_MULTISPORT_SUBGAME_STALE_SECONDS=600
GOOL_MULTISPORT_MAX_SUBGAMES_PER_EVENT=8
GOOL_MULTISPORT_SUBGAME_WORKERS=3
GOOL_MULTISPORT_UNKNOWN_MARKET_CATALOG_MAX=160
GOOL_HOCKEY_PERIOD_THRESHOLD_SCALE=0.65
GOOL_HOCKEY_TEAM_TOTAL_THRESHOLD_SCALE=0.75
GOOL_BASKETBALL_QUARTER_THRESHOLD_SCALE=0.45
GOOL_BASKETBALL_HALF_THRESHOLD_SCALE=0.68
GOOL_BASKETBALL_TEAM_TOTAL_THRESHOLD_SCALE=0.72

# Football PREMATCH: primary shortlist remains strict; this bounded rescue only
# recovers strong structural profiles whose evidence quality is 0.55-0.62.
GOOL_PREMATCH_RESCUE_MIN_QUALITY=0.55
GOOL_PREMATCH_RESCUE_MIN_SAMPLE=10
GOOL_PREMATCH_RESCUE_MIN_AGREEMENT=0.76
GOOL_PREMATCH_RESCUE_MIN_SEPARATION=0.030
GOOL_PREMATCH_RESCUE_MIN_PROBABILITY=0.68
GOOL_PREMATCH_RESCUE_MAX=12

# PREMATCH lane: upcoming hockey/basketball totals from Flashscore schedule + 1xBet LineFeed.
# Signals are based on pre-kickoff line/probability movement and are journaled separately from LIVE.
GOOL_MULTISPORT_PREMATCH_ENABLED=1
GOOL_MULTISPORT_PREMATCH_HORIZON_SECONDS=108000
GOOL_MULTISPORT_PREMATCH_WINDOW_SECONDS=21600
GOOL_MULTISPORT_PREMATCH_MIN_AGE_SECONDS=60
GOOL_MULTISPORT_PREMATCH_MAX_MAPPED_PER_SPORT=160
GOOL_MULTISPORT_PREMATCH_MIN_FAIR_EDGE_PP=2.0
GOOL_HOCKEY_PREMATCH_MIN_METRIC_DELTA=0.35
GOOL_HOCKEY_PREMATCH_MIN_LINE_DELTA=0.5
GOOL_BASKETBALL_PREMATCH_MIN_METRIC_DELTA=2.0
GOOL_BASKETBALL_PREMATCH_MIN_LINE_DELTA=2.5

GOOL_MULTISPORT_STATE=/data/live/gool_multisport_state.json
GOOL_MULTISPORT_HISTORY=/data/live/gool_multisport_history.jsonl
GOOL_MULTISPORT_JOURNAL=/data/live/gool_multisport_signals.json

# 1xBet market telemetry
# Ordinary GOOL requests detailed live prices only after football reaches
# PASS/BORDERLINE. Autonomous STEAM keeps a narrow independent watch lane.
XBET_MARKET_REQUIRED=1
XBET_MARKET_INTERVAL_SECONDS=12
XBET_MATCH_MIN_SCORE=0.68
XBET_GAME_WORKERS=12
XBET_MARKET_DEMAND_TTL_SECONDS=90
XBET_STEAM_WATCH_PER_CYCLE=16
XBET_OVERRIDE_MAX_AGE_SECONDS=35
XBET_OVERRIDE_MIN_DELTA_PP=6
XBET_OVERRIDE_MIN_ONE_WAY_MOVES=2
XBET_OVERRIDE_MIN_MODEL_PROBABILITY=0.55

# Matchbook MONEY FLOW
# The fast-flow lane watches new matched money in 30/60 second windows.
# The total-volume lane separately detects unusually large accumulated volume
# in non-top competitions, but still requires the Over fair price to move in the
# same direction; total turnover alone never creates a bet.
MATCHBOOK_FLOW_BET_MIN_MARKET_VOLUME=500
MATCHBOOK_FLOW_BET_MIN_DELTA_30S=250
MATCHBOOK_FLOW_BET_MIN_DELTA_60S=500
MATCHBOOK_FLOW_BET_MIN_RELATIVE_PCT=8
MATCHBOOK_FLOW_BET_MIN_FAIR_PP=2
MATCHBOOK_FLOW_NON_TOP_TOTAL_VOLUME_GBP=5000
MATCHBOOK_FLOW_NON_TOP_EXTREME_TOTAL_VOLUME_GBP=10000
MATCHBOOK_FLOW_NON_TOP_TOTAL_MIN_FAIR_PP=0.75
MATCHBOOK_FLOW_TOP_TOTAL_VOLUME_GBP=25000
MATCHBOOK_FLOW_TOP_EXTREME_TOTAL_VOLUME_GBP=75000

# Event repricing protection: a goal/red card/VAR/penalty-like odds shock is
# not treated as organic 1xBet steam. Pressure history is reset while guarded.
XBET_SCORE_REPRICE_GUARD_SECONDS=24
XBET_EVENT_REPRICE_GUARD_SECONDS=45
XBET_TIMELINE_REPRICE_GUARD_SECONDS=45
XBET_ODDS_SHOCK_GUARD_PP=12

# VALUE BET: GOOL probability minus 1xBet fair probability (margin removed)
XBET_VALUE_MIN_EDGE_PP=5
XBET_VALUE_STRONG_EDGE_PP=8
XBET_VALUE_VERY_STRONG_EDGE_PP=12
XBET_VALUE_MIN_MODEL_PROBABILITY=0.60
XBET_VALUE_OVERRIDE_MIN_MODEL_PROBABILITY=0.65
XBET_VALUE_MIN_ODD=1.50
XBET_VALUE_MAX_ODD=4.50
XBET_VALUE_MAX_AGE_SECONDS=35

# Signal thresholds
ANOTHER_GOAL_MIN_SCORE=75
OVER25_MIN_SCORE=70
OVER25_MIN_PROBABILITY=70
BTTS_MIN_SCORE=70
BTTS_MIN_PROBABILITY=70

# Trained models
ARCHIVE_FOUNDATION_MODEL=/data/models/archive_foundation.pkl
ARCHIVE_HAZARD_MODEL=/data/models/archive_hazard.pkl
FOOTBALL_DATA_GOAL_MODEL=/data/models/football_data_goal_models.pkl

# Football providers / legacy migration variables.
# Core GOOL Bot 2 models do not require an LLM.
FLASHSCORE_FSIGN=SW9D1eZo
GOAL_API_KEY=
GOAL_DAILY_SOFT_CAP=850
ENRICH_MIN_MASTER=50
SPORTSGAMEODDS_KEY=
SPORTSGAMEODDS_TTL=180
DATABASE_PATH=/data/gool_bot2.db

# Historical backfill only; not required for live production runtime.
FLASHSCORE_ARCHIVE_DELAY_SECONDS=2.2
FLASHSCORE_ARCHIVE_FILE=/data/raw/flashscore_archive.jsonl
