# Telegram (same variable names as legacy GOOL Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_EXTRA_CHAT_IDS=
TELEGRAM_SUBSCRIBERS_FILE=/data/telegram_subscribers.json

# Persistent runtime storage
RUNTIME_DATA_DIR=/data
GOOL_INBOX_DIR=/data/raw/live
SIGNAL_JOURNAL_PATH=/data/live/signal_journal.json
SIGNAL_ANALYSIS_PATH=/data/live/gool_bot2_analysis.jsonl
GOOL_MULTI_ANALYSIS_PATH=/data/live/gool_multi_analysis.jsonl
GOOL_MULTI_JOURNAL_PATH=/data/live/gool_multi_journal.json

# Live runtime
LIVE_INTERVAL_SECONDS=60
LIVE_COOLDOWN_MINUTES=12
CORE_ANALYSIS_PREFILTER=38
SECONDARY_PROVIDER_INTERVAL_MINUTES=3
MODEL_MAX_DISAGREEMENT=0.20

# 1xBet market telemetry
XBET_MARKET_REQUIRED=1
XBET_MARKET_INTERVAL=12
XBET_MATCH_MIN_SCORE=0.68
XBET_GAME_WORKERS=8
XBET_OVERRIDE_MAX_AGE_SECONDS=35
XBET_OVERRIDE_MIN_DELTA_PP=6
XBET_OVERRIDE_MIN_ONE_WAY_MOVES=2
XBET_OVERRIDE_MIN_MODEL_PROBABILITY=0.55

# VALUE BET: GOOL probability minus 1xBet fair probability (margin removed)
XBET_VALUE_MIN_EDGE_PP=5
XBET_VALUE_STRONG_EDGE_PP=8
XBET_VALUE_VERY_STRONG_EDGE_PP=12
XBET_VALUE_MIN_MODEL_PROBABILITY=0.60
XBET_VALUE_OVERRIDE_MIN_MODEL_PROBABILITY=0.65
XBET_VALUE_MIN_ODD=1.45
XBET_VALUE_MAX_ODD=4.50
XBET_VALUE_MAX_AGE_SECONDS=35

# Signal thresholds
ANOTHER_GOAL_MIN_SCORE=75
OVER25_MIN_SCORE=70
OVER25_MIN_PROBABILITY=70
BTTS_MIN_SCORE=70
BTTS_MIN_PROBABILITY=70

# Trained models
ARCHIVE_FOUNDATION_MODEL=/data/models/archive_foundation.pkl
ARCHIVE_HAZARD_MODEL=/data/models/archive_hazard.pkl
FOOTBALL_DATA_GOAL_MODEL=/data/models/football_data_goal_models.pkl

# Football providers / legacy migration variables.
# Core GOOL Bot 2 models do not require an LLM.
FLASHSCORE_FSIGN=SW9D1eZo
GOAL_API_KEY=
GOAL_DAILY_SOFT_CAP=850
ENRICH_MIN_MASTER=50
SPORTSGAMEODDS_KEY=
SPORTSGAMEODDS_TTL=180
DATABASE_PATH=/data/gool_bot2.db

# Historical backfill only; not required for live production runtime.
FLASHSCORE_ARCHIVE_DELAY_SECONDS=2.2
FLASHSCORE_ARCHIVE_FILE=/data/raw/flashscore_archive.jsonl
